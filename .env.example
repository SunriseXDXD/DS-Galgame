# 正式部署推荐：由服务端持有密钥，浏览器中不出现 Key 输入框。
DEEPSEEK_API_KEY=

# 仅本地、自托管时按需开启用户自带 Key。开发模式默认开启。
ALLOW_BYOK=false

# 可选
PORT=5173
HOST=127.0.0.1

# 对公网或局域网提供服务时必须填写浏览器实际访问的唯一来源（协议 + 域名 + 可选端口）。
PUBLIC_ORIGIN=

# 反向代理后按实际拓扑填写明确跳数（如 1）或逗号分隔的可信 IP/CIDR；不要写 true。
TRUST_PROXY=false
RATE_LIMIT_MAX=30
MAX_CONCURRENT_REQUESTS=6
